{
  "name": "vanbransa-pos-workspace",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "test": "npm --prefix frontend test && npm --prefix backend/functions test",
    "test:frontend": "npm --prefix frontend test",
    "test:backend": "npm --prefix backend/functions test",
    "smoke": "node scripts/smoke-test.mjs",
    "emulators": "node scripts/start-emulators.cjs",
    "emulators:doctor": "node scripts/start-emulators.cjs --doctor",
    "test:emulator-runner": "node --test scripts/test/emulator-runner.test.cjs",
    "deploy": "npm run build && firebase deploy"
  }
}
