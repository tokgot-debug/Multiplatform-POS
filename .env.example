# Firebase Web SDK configuration for the Vanbransa POS till.
#
# These are public client identifiers, not secrets - they ship inside the
# browser bundle by design. Access is controlled by Firestore security rules
# and the trusted Cloud Functions, never by hiding these values.
#
# Copy to .env before building:  cp .env.example .env

VITE_FIREBASE_API_KEY=AIzaSyD-5GMK_yz2uAFW6TNTSOxJziqPbTFCeaU
VITE_FIREBASE_AUTH_DOMAIN=vanbransa-pos.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vanbransa-pos
VITE_FIREBASE_STORAGE_BUCKET=vanbransa-pos.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1038626006725
VITE_FIREBASE_APP_ID=1:1038626006725:web:888c421e0b2cdfd772f2ac

# Region hosting the callable functions. Must match Firestore's location.
VITE_FIREBASE_REGION=europe-west1

# Tenant and device this till belongs to. Set during provisioning.
VITE_TENANT_ID=tenant-01
VITE_DEVICE_ID=device-till-01

# Set to 1 to point the till at local emulators instead of the live project.
VITE_USE_EMULATORS=0
